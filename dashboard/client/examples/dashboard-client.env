# Copy to /etc/dashboard-client.env, chmod 600
SOURCE_ID=gcp-ai-workstation
SOURCE_TOKEN=replace-with-plain-token
SERVER_URL=https://dashboard.<tailnet>.ts.net:8787

# Optional
# SPOOL_PATH=/var/lib/dashboard-client/spool.jsonl
# SPOOL_MAX=200
# TIMEOUT_S=5
# TLS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
